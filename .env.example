# Copy to .env. Never commit real values. Wrangler reads .env locally.
IMAP_SERVER="imap.qq.com"
IMAP_PORT="993"
IMAP_ACCOUNT="your-account@qq.com"
IMAP_SECRET="your-qq-imap-authorization-code"
# Generate a separate random owner passphrase (at least 32 characters).
AUTH_PASSWORD="replace-with-a-generated-random-owner-passphrase"
# MAIL_FROM="your-account@qq.com"
# IMAP_DRAFTS_MAILBOX="Drafts"
