# Optional local IMAP testing only. Never commit real values.
# Production secrets are managed in the Worker Dashboard, not this file.
# IMAP_SERVER / IMAP_PORT come from wrangler.jsonc.
IMAP_ACCOUNT="your-account@qq.com"
IMAP_SECRET="your-qq-imap-authorization-code"
# OAuth tests inject their own test-only AUTH_PASSWORD; no local login secret needed.
# Optional MAIL_FROM / IMAP_DRAFTS_MAILBOX belong in wrangler.jsonc vars for local testing.
